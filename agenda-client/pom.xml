<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modulo del cliente. Incluye el cliente de consola, el cliente JavaFX y el
  programa de prueba de concurrencia.
  - El perfil por defecto genera un jar "shade" cuya clase principal es el
    cliente de consola (no necesita JavaFX para funcionar).
  - El plugin javafx-maven-plugin permite lanzar la GUI con "mvn javafx:run".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>mx.edu.itigualapa</groupId>
    <artifactId>agenda-rmi</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>agenda-client</artifactId>
  <packaging>jar</packaging>
  <name>Agenda RMI - Cliente</name>

  <dependencies>
    <dependency>
      <groupId>mx.edu.itigualapa</groupId>
      <artifactId>agenda-common</artifactId>
    </dependency>

    <!-- JavaFX: se resuelve el clasificador nativo segun el sistema operativo -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
    </dependency>

    <!-- Driver de SQLite: solo lo usa PruebaConcurrencia para verificar
         directamente la base de datos cuando servidor y prueba estan en la
         misma maquina. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>agenda-client</finalName>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>mx.edu.itigualapa.agenda.client.ClienteFX</mainClass>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>mx.edu.itigualapa.agenda.client.ClienteConsola</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
