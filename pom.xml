<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM padre del proyecto "Sistema de Agenda Personal con RMI y Base de Datos".
  Instituto Tecnologico de Iguala - IFF-1019 Programacion en Ambiente Cliente Servidor.
  Centraliza la version de Java, la codificacion y las versiones de dependencias
  y plugins para que los tres modulos hijos las hereden.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>mx.edu.itigualapa</groupId>
  <artifactId>agenda-rmi</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Agenda Personal RMI</name>
  <description>Aplicacion distribuida Java RMI + JDBC para administrar una agenda de contactos</description>

  <modules>
    <module>agenda-common</module>
    <module>agenda-server</module>
    <module>agenda-client</module>
  </modules>

  <properties>
    <!-- JDK 21 LTS -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Versiones de dependencias verificadas en Maven Central -->
    <sqlite.version>3.49.1.0</sqlite.version>
    <javafx.version>21.0.7</javafx.version>

    <!-- Versiones de plugins -->
    <compiler.plugin.version>3.14.1</compiler.plugin.version>
    <jar.plugin.version>3.5.0</jar.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
    <surefire.plugin.version>3.5.6</surefire.plugin.version>
    <javafx.plugin.version>0.0.8</javafx.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Modulo comun: interfaz remota, DTO y validaciones -->
      <dependency>
        <groupId>mx.edu.itigualapa</groupId>
        <artifactId>agenda-common</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Driver JDBC de SQLite (base de datos sin servidor) -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.version}</version>
      </dependency>

      <!-- JavaFX para el cliente grafico -->
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-base</artifactId>
        <version>${javafx.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>${javafx.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
