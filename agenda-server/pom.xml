<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modulo del servidor RMI. Depende del modulo comun y del driver JDBC de SQLite.
  Genera un jar ejecutable "con todo dentro" (shade) para poder arrancar el
  servidor con un simple "java -jar", sin armar el classpath a mano.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>mx.edu.itigualapa</groupId>
    <artifactId>agenda-rmi</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>agenda-server</artifactId>
  <packaging>jar</packaging>
  <name>Agenda RMI - Servidor</name>

  <dependencies>
    <dependency>
      <groupId>mx.edu.itigualapa</groupId>
      <artifactId>agenda-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>agenda-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>mx.edu.itigualapa.agenda.server.ServidorAgenda</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
